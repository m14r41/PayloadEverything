// Version resource for shellcode_runner_v2.exe
// Compile:
//   Linux: x86_64-w64-mingw32-windres shellcode_runner_v2.rc -o rc.o
//   MSVC:  rc shellcode_runner_v2.rc
//
// Embeds a custom VERSIONINFO so Task Manager Processes tab shows
// "RevShell Runner" as the big text (FileDescription) instead of
// the default empty / tool-generated string.

1 VERSIONINFO
 FILEVERSION     2,0,0,0
 PRODUCTVERSION  2,0,0,0
 FILEOS          0x40004L
 FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "m14r41 Labs\0"
            VALUE "FileDescription",  "RevShell Runner\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "runner_v2\0"
            VALUE "OriginalFilename", "runner_v2.exe\0"
            VALUE "ProductName",      "RevShell Payload Harness\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
